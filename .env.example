PORT=5000
NODE_ENV=development
DATABASE_URL="file:./dev.db"
JWT_SECRET="research2reality_super_secret_jwt_key_2026_prod"
JWT_EXPIRES_IN="7d"

# AI Provider Configuration
# Set AI_PROVIDER to 'openai' or 'mock' (Defaults to 'mock' if OPENAI_API_KEY is not set)
AI_PROVIDER=mock
OPENAI_API_KEY=
OPENAI_MODEL="gpt-4o-mini"

# External APIs (Optional - Fallbacks built in)
OPENALEX_API_KEY=
CROSSREF_API_KEY=
SEMANTIC_SCHOLAR_API_KEY=
PATENT_API_KEY=

# Storage Provider (local | s3)
STORAGE_PROVIDER=local
