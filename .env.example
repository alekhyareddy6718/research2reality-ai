# Core Server Configuration
PORT=5000
NODE_ENV=development

# Database Connection (file:./dev.db for SQLite, postgresql://... for PostgreSQL)
DATABASE_URL="file:./dev.db"

# JWT Authentication Configuration
JWT_SECRET="research2reality_super_secret_jwt_key_2026_prod"
JWT_EXPIRES_IN="7d"

# CORS & Domain Configuration (Render Backend)
FRONTEND_URL="http://localhost:3000"
ALLOWED_ORIGINS="http://localhost:3000"

# Frontend API URL (Vercel Frontend)
NEXT_PUBLIC_API_URL="http://localhost:5000/api/v1"

# AI Provider Configuration
# Set AI_PROVIDER to 'openai' or 'mock' (Defaults to 'mock' if OPENAI_API_KEY is not set)
AI_PROVIDER=mock
OPENAI_API_KEY=
OPENAI_MODEL="gpt-4o-mini"

# External APIs (Optional - Fallbacks built in)
OPENALEX_API_KEY=
CROSSREF_API_KEY=
SEMANTIC_SCHOLAR_API_KEY=
PATENT_API_KEY=

# Storage Provider (local | memory | s3)
STORAGE_PROVIDER=local

